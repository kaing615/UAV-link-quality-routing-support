+uint8_t
+RoutingProtocol::EncodeLq(double value)
+{
+    return static_cast<uint8_t>(std::lround(std::clamp(value, 0.0, 1.0) * 255.0));
+}
+
+double
+RoutingProtocol::DecodeLq(uint8_t value)
+{
+    return value / 255.0;
+}
+
+double
+RoutingProtocol::PairEtx(uint8_t lq, uint8_t nlq)
+{
+    const double product = DecodeLq(lq) * DecodeLq(nlq);
+    return product < 1e-3 ? std::numeric_limits<double>::infinity() : 1.0 / product;
+}
+
+void
+RoutingProtocol::UpdateLinkQuality(const Ipv4Address& senderIface, uint16_t seq)
+{
+    LqState& s = m_lq[senderIface];
+    if (s.init)
+    {
+        uint16_t gap = static_cast<uint16_t>(seq - s.lastSeq - 1);
+        if (gap < 64) // larger gaps: restart or reordering, not counted as losses
+        {
+            for (uint16_t k = 0; k < gap; ++k)
+            {
+                s.lq *= 1.0 - m_lqAging;
+            }
+        }
+        s.lq = (1.0 - m_lqAging) * s.lq + m_lqAging;
+    }
+    else
+    {
+        s.lq = 1.0; // optimistic start, as a fresh symmetric link
+        s.init = true;
+    }
+    s.lastSeq = seq;
+    s.lastRx = Simulator::Now();
+}
+
+void
+RoutingProtocol::AgeLinkQuality()
+{
+    // A neighbour silent for more than 1.5 HELLO intervals has lost a packet.
+    for (auto& entry : m_lq)
+    {
+        if (entry.second.init && Simulator::Now() - entry.second.lastRx > 1.5 * m_helloInterval)
+        {
+            entry.second.lq *= 1.0 - m_lqAging;
+        }
+    }
+}
+
+double
+RoutingProtocol::LinkEtx(const Ipv4Address& neighborIface) const
+{
+    auto state = m_lq.find(neighborIface);
+    if (state == m_lq.end())
+    {
+        return std::numeric_limits<double>::infinity();
+    }
+    const double lq = state->second.lq;
+    const double nlq = state->second.nlq < 0 ? lq : state->second.nlq;
+    const double product = lq * nlq;
+    return product < 1e-3 ? std::numeric_limits<double>::infinity() : 1.0 / product;
+}
+
+void
+RoutingProtocol::LqRoutes()
+{
+    // Dijkstra on ETX over: own symmetric links (local LQ, neighbour-reported NLQ),
+    // neighbours' 2-hop links (LQ_HELLO) and advertised topology (LQ_TC).
+    struct Hop
+    {
+        Ipv4Address nextAddr;
+        Ipv4Address ifaceAddr;
+    };
+
+    const Time now = Simulator::Now();
+    std::map<Ipv4Address, std::vector<std::pair<Ipv4Address, double>>> edges;
+    std::map<Ipv4Address, Hop> firstHop; // neighbour main address -> best own link
+    std::map<Ipv4Address, double> firstCost;
+    std::set<Ipv4Address> relays;        // neighbours allowed to forward (willingness != NEVER)
+    for (const auto& nb : m_state.GetNeighbors())
+    {
+        if (nb.status != NeighborTuple::STATUS_SYM)
+        {
+            continue;
+        }
+        if (nb.willingness != Willingness::NEVER)
+        {
+            relays.insert(nb.neighborMainAddr);
+        }
+        for (const auto& link : m_state.GetLinks())
+        {
+            if (GetMainAddress(link.neighborIfaceAddr) != nb.neighborMainAddr || link.time < now)
+            {
+                continue;
+            }
+            const double cost = LinkEtx(link.neighborIfaceAddr);
+            auto known = firstCost.find(nb.neighborMainAddr);
+            if (std::isfinite(cost) && (known == firstCost.end() || cost < known->second))
+            {
+                firstCost[nb.neighborMainAddr] = cost;
+                firstHop[nb.neighborMainAddr] = Hop{link.neighborIfaceAddr, link.localIfaceAddr};
+            }
+        }
+    }
+    for (const auto& t : m_state.GetTwoHopNeighbors())
+    {
+        if (relays.count(t.neighborMainAddr) && t.twoHopNeighborAddr != m_mainAddress &&
+            std::isfinite(t.etx))
+        {
+            edges[t.neighborMainAddr].emplace_back(t.twoHopNeighborAddr, t.etx);
+        }
+    }
+    for (const auto& t : m_state.GetTopologySet())
+    {
+        if (t.destAddr != m_mainAddress && std::isfinite(t.etx))
+        {
+            edges[t.lastAddr].emplace_back(t.destAddr, t.etx);
+        }
+    }
+
+    // (cost, hops, address) ordering keeps the result deterministic.
+    std::map<Ipv4Address, std::tuple<double, uint32_t, Ipv4Address>> best; // dest -> (cost, hops, first)
+    std::set<std::tuple<double, uint32_t, Ipv4Address, Ipv4Address>> queue;  // (cost, hops, node, first)
+    for (const auto& [nb, cost] : firstCost)
+    {
+        best[nb] = {cost, 1, nb};
+        queue.insert({cost, 1, nb, nb});
+    }
+    while (!queue.empty())
+    {
+        auto [cost, hops, node, first] = *queue.begin();
+        queue.erase(queue.begin());
+        auto current = best.find(node);
+        if (current == best.end() || std::get<0>(current->second) < cost)
+        {
+            continue;
+        }
+        // Only symmetric neighbours (and, transitively, nodes reached through them) relay;
+        // a neighbour with willingness NEVER is a destination but not a relay.
+        if (hops == 1 && !relays.count(node))
+        {
+            continue;
+        }
+        for (const auto& [next, edgeCost] : edges[node])
+        {
+            if (next == m_mainAddress)
+            {
+                continue;
+            }
+            const double total = cost + edgeCost;
+            auto known = best.find(next);
+            if (known == best.end() || total < std::get<0>(known->second))
+            {
+                best[next] = {total, hops + 1, first};
+                queue.insert({total, hops + 1, next, first});
+            }
+        }
+    }
+    for (const auto& [dest, value] : best)
+    {
+        const Hop& hop = firstHop[std::get<2>(value)];
+        AddEntry(dest, hop.nextAddr, hop.ifaceAddr, std::get<1>(value));
+    }
+    // Neighbour interface addresses that differ from the main address (multi-interface nodes).
+    for (const auto& link : m_state.GetLinks())
+    {
+        RoutingTableEntry entry;
+        if (link.time >= now && !Lookup(link.neighborIfaceAddr, entry))
+        {
+            auto main = best.find(GetMainAddress(link.neighborIfaceAddr));
+            if (main != best.end())
+            {
